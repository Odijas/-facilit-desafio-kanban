    {
      "name": "04 — Kanban, filtros e indicadores",
      "item": [
        {
          "name": "Transição A iniciar → Em andamento",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/projects/{{projectId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "projects",
                "{{projectId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const project = pm.response.json();",
                  "pm.test(\"status IN_PROGRESS\", () => pm.expect(project.status).to.eql(\"IN_PROGRESS\"));",
                  "pm.test(\"início realizado = hoje\", () => pm.expect(project.actualStart).to.eql(pm.collectionVariables.get(\"today\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Transição bloqueada Em andamento → Atrasado → 422",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/projects/{{projectId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "projects",
                "{{projectId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"OVERDUE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"code = TRANSITION_BLOCKED\", () => pm.expect(pm.response.json().code).to.eql(\"TRANSITION_BLOCKED\"));",
                  "pm.test(\"orientação em pt-BR\", () => pm.expect(pm.response.json().detail).to.include(\"Em andamento → Atrasado bloqueado\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Em andamento → A iniciar sem confirmação → 422",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/projects/{{projectId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "projects",
                "{{projectId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"NOT_STARTED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"code = CONFIRMATION_REQUIRED\", () => pm.expect(pm.response.json().code).to.eql(\"CONFIRMATION_REQUIRED\"));",
                  "pm.test(\"data que seria apagada\", () => pm.expect(pm.response.json().clearedField).to.eql(\"actualStart\"));"
                ]
              }
            }
          ]
