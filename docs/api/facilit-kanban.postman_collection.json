  "item": [
    {
      "name": "01 — Público e acesso anônimo",
      "item": [
        {
          "name": "Health (REST)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"runId\", String(Date.now()));",
                  "// \"Hoje\" da API é a data em America/Sao_Paulo (APP_TIME_ZONE): UTC-3, sem horário de verão desde 2019.",
                  "const today = new Date(Date.now() - 3 * 60 * 60 * 1000);",
                  "const end = new Date(today.getTime() + 10 * 24 * 60 * 60 * 1000);",
                  "pm.collectionVariables.set(\"today\", today.toISOString().slice(0, 10));",
                  "pm.collectionVariables.set(\"plannedEnd\", end.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"status UP\", () => pm.expect(pm.response.json().status).to.eql(\"UP\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Projetos sem sessão → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/projects?page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "projects"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"code = UNAUTHORIZED\", () => pm.expect(pm.response.json().code).to.eql(\"UNAUTHORIZED\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 — Autenticação (sessão + CSRF)",
      "item": [
        {
          "name": "CSRF (antes do login)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/csrf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "csrf"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const token = pm.cookies.get(\"XSRF-TOKEN\");",
                  "pm.test(\"cookie XSRF-TOKEN recebido\", () => pm.expect(token, \"XSRF-TOKEN\").to.be.a(\"string\").and.not.empty);",
                  "pm.collectionVariables.set(\"csrfToken\", token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"ROLE_ADMIN\", () => pm.expect(pm.response.json().authorities).to.include(\"ROLE_ADMIN\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "CSRF (renovado após login)",
          "request": {
            "method": "GET",
